# ============================================
# Android Studio / IntelliJ
# ============================================
*.iml
*.iws
*.ipr
.idea/
.gradle/
captures/
.navigation/
caches/

# Исключения — эти файлы IDE полезно хранить в репо
!.idea/codeStyles/
!.idea/inspectionProfiles/
!.idea/compiler.xml
!.idea/encodings.xml
!.idea/vcs.xml
!.idea/misc.xml

# ============================================
# Gradle
# ============================================
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
local.properties

# ============================================
# Kotlin / KSP
# ============================================
.kotlin/
ksp-cache/
*.kotlin_module

# ============================================
# Android build artifacts
# ============================================
*.apk
*.aab
*.ap_
*.dex
*.class
bin/
gen/
out/
release/
captures/

# ============================================
# Hilt / Dagger generated
# ============================================
# Всё генерируется в build/, но на всякий случай:
**/generated/
**/generated-sources/
**/generated-test-sources/

# ============================================
# Room schema (если экспортируете схему в JSON)
# ============================================
# Обычно схемы коммитят — оставляем.
# Если НЕ нужно — раскомментируйте:
# app/schemas/

# ============================================
# Логи, временные файлы
# ============================================
*.log
*.tmp
*.swp
*~
.DS_Store
Thumbs.db

# ============================================
# Environment / secrets
# ============================================
.env
.env.*
!.env.example
secrets.properties
keystore.properties
*.jks
*.keystore

# ============================================
# Firebase (если подключите позже)
# ============================================
google-services.json
# Если хотите хранить в репо для CI — уберите эту строку

# ============================================
# Нативные библиотеки
# ============================================
.externalNativeBuild/
.cxx/
*.so

# ============================================
# Compose
# ============================================
# Compose использует стандартный build/ — отдельно ничего не нужно

