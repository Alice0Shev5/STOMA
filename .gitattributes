# Нормализация окончаний строк — LF в репо, авто в рабочей копии
* text=auto eol=lf

# Явно для текстовых файлов
*.kt      text eol=lf
*.kts     text eol=lf
*.java    text eol=lf
*.xml     text eol=lf
*.md      text eol=lf
*.toml    text eol=lf
*.pro     text eol=lf
*.properties text eol=lf
.gitignore text eol=lf

# Скрипты всегда LF
gradlew   text eol=lf
*.sh      text eol=lf

# Windows-скрипты всегда CRLF
*.bat     text eol=crlf

# Бинарные файлы — не трогать
*.jar     binary
*.apk     binary
*.aab     binary
*.png     binary
*.jpg     binary
*.webp    binary
*.so      binary
*.keystore binary
*.jks     binary